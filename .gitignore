# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# This repo's committed lockfile is bun.lock (bun is the project's intended
# package manager). This sandbox only has npm/node available, so some
# sessions use npm to install dependencies locally — don't let that produce
# a second, conflicting lockfile in git. See docs/implementation/00-repo-audit.md §6.2.
/package-lock.json

# local sqlite database — never commit live data/credentials, see
# docs/implementation/00-repo-audit.md §5.5. `bun run db:push` / `prisma db
# push` recreates the schema; seed scripts (if any) recreate sample data.
/db/*.db
/db/*.db-journal

# scratch QA/tool-run artifacts from prior coding-agent sessions — not source.
/tool-results/
/download/


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/