// WAKEEL (وكيل) — AI Employee Platform — Prisma schema
// NOTE: Prisma primitives cannot be lists. All JSON payloads (blueprint,
// capabilities, record data, scan results) are stored as String.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Account = the REAL authenticated human (email + password). One account
/// owns many operators (workspaces). All API access is scoped to the account
/// resolved from the httpOnly session cookie — never from client input.
model Account {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
  operators    User[]

  @@index([email])
}

model User {
  id        String        @id @default(cuid())
  accountId String?
  account   Account?      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  workspace String
  role      String?
  createdAt DateTime      @default(now())
  systems   AiSystem[]
  scans     ScanSession[]
  activities Activity[]
  chats     ChatMessage[]

  @@index([accountId])
}

model AiSystem {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String
  category     String // CRM | ERP | FINANCE | HR | COMMUNICATION | STORAGE | MARKETING | SUPPORT | OPERATIONS | CUSTOM
  icon         String // lucide icon name
  color        String
  origin       String // DISCOVERED | CREATED
  status       String         @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  health       Int            @default(90)
  confidence   Int?
  source       String?
  blueprint    String         @default("{}")
  capabilities String         @default("[]")
  records      SystemRecord[]
  runs         AutomationRun[]
  shares       ShareLink[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId])
}

model SystemRecord {
  id        String   @id @default(cuid())
  systemId  String
  system    AiSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  data      String // JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([systemId])
}

model AutomationRun {
  id         String   @id @default(cuid())
  systemId   String
  system     AiSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  automation String // the blueprint automation description that was executed
  status     String   @default("RUNNING") // RUNNING | DONE | FAILED
  trigger    String   @default("MANUAL") // MANUAL | SCHEDULE | EVENT
  log        String   @default("[]") // JSON string: [{ t, line, level }]
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([systemId])
}

model ShareLink {
  id        String   @id @default(cuid())
  systemId  String
  system    AiSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  token     String   @unique
  views     Int      @default(0)
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([systemId])
}

model ScanSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  target       String
  notes        String?
  status       String   @default("RUNNING") // RUNNING | COMPLETE | FAILED
  systemsFound Int      @default(0)
  result       String   @default("{}") // JSON string {summary, searchedAt, queryCount}
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // SCAN | FORGE | ADOPT | ARCHIVE | RESTORE | DELETE | RECORD | CHAT | STATUS
  title     String
  detail    String?
  status    String   @default("DONE") // RUNNING | DONE | FAILED
  createdAt DateTime @default(now())

  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // USER | AGENT
  content   String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Durable WAKIL accounting execution. Every child table carries tenantId so
// application queries can enforce isolation without trusting a task/step id.
model RuntimeTask {
  id           String              @id
  tenantId     String
  actorId      String
  workflowType String
  status       String
  riskClass    String
  inputJson    String
  resultJson   String?
  deadline     DateTime
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  steps        RuntimeTaskStep[]
  approvals    RuntimeApproval[]
  events       RuntimeTaskEvent[]

  @@unique([tenantId, id])
  @@index([tenantId, status, updatedAt])
}

model RuntimeTaskStep {
  id          String      @id
  tenantId    String
  taskId      String
  sequence    Int
  name        String
  status      String
  attempt     Int
  maxAttempts Int
  inputJson   String?
  outputJson  String?
  errorCode   String?
  errorMessage String?
  idempotencyKey String?
  startedAt   DateTime?
  finishedAt  DateTime?
  task        RuntimeTask @relation(fields: [tenantId, taskId], references: [tenantId, id], onDelete: Cascade)
  approvals   RuntimeApproval[]

  @@unique([tenantId, taskId, id])
  @@unique([taskId, sequence])
  @@index([tenantId, taskId, status])
}

model RuntimeApproval {
  id               String          @id
  tenantId         String
  taskId           String
  stepId           String
  toolName         String
  actionHash       String
  normalizedParamsJson String
  policyVersion    String
  riskLevel        String
  summary          String
  status           String
  requestedAt      DateTime        @default(now())
  expiresAt        DateTime
  decidedBy        String?
  decidedAt        DateTime?
  reason           String?
  task             RuntimeTask     @relation(fields: [tenantId, taskId], references: [tenantId, id], onDelete: Cascade)
  step             RuntimeTaskStep @relation(fields: [tenantId, taskId, stepId], references: [tenantId, taskId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, status, expiresAt])
}

model RuntimeTaskEvent {
  id        String      @id
  tenantId  String
  taskId    String
  sequence  Int
  type      String
  actorType String
  actorId   String?
  payloadJson String
  createdAt DateTime    @default(now())
  task      RuntimeTask @relation(fields: [tenantId, taskId], references: [tenantId, id], onDelete: Cascade)

  @@unique([taskId, sequence])
  @@index([tenantId, taskId, sequence])
}

model RuntimeIdempotencyRecord {
  tenantId      String
  toolName      String
  idempotencyKey String
  requestHash   String
  status        String
  resultRefJson String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@id([tenantId, toolName, idempotencyKey])
  @@index([tenantId, status, updatedAt])
}
