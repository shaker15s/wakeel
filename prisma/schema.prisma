/**
 * WAKEEL (وكيل) — AI Employee Platform — Prisma schema v0.2
 * Adds durable task/step/approval/idempotency/memory persistence for the accounting agent.
 * NOTE: Prisma primitives cannot be lists. All JSON payloads are stored as String.
 * Prisma client binary cannot be downloaded in this sandbox (binaries.prisma.sh blocked),
 * so migrations are provided as raw SQL for manual application against a disposable SQLite DB.
 */

/**------------------------------------------------------------------------------
 * generator
 *-----------------------------------------------------------------------------*/
generator client {
  provider = "prisma-client-js"
}

/**------------------------------------------------------------------------------
 * datasource
 *-----------------------------------------------------------------------------*/
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/**------------------------------------------------------------------------------
 * Core models
 *-----------------------------------------------------------------------------*/

/**------------------------------------------------------------------------------
 * Account = the REAL authenticated human (email + password). One account
 * owns many operators (workspaces). All API access is scoped to the account
 * resolved from the httpOnly session cookie — never from client input.
 *-----------------------------------------------------------------------------*/
model Account {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
  operators    User[]

  @@index([email])
}

/**------------------------------------------------------------------------------
 * Tenant / operator model. One account owns many users/workspaces.
 *-----------------------------------------------------------------------------*/
model User {
  id        String    @id @default(cuid())
  accountId String?
  account   Account?      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  workspace String
  role      String?
  createdAt DateTime      @default(now())
  systems   AiSystem[]
  scans     ScanSession[]
  activities Activity[]
  chats     ChatMessage[]

  @@index([accountId])
}

/**------------------------------------------------------------------------------
 * ai-system metadata (CRM, ERP, FINANCE, etc.)
 *-----------------------------------------------------------------------------*/
model AiSystem {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String
  category     String // CRM | ERP | FINANCE | HR | COMMUNICATION | STORAGE | MARKETING | SUPPORT | OPERATIONS | CUSTOM
  icon         String // lucide icon name
  color        String
  origin       String // DISCOVERED | CREATED
  status       String         @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  health       Int            @default(90)
  confidence   Int?
  source       String?
  blueprint    String         @default("{}")
  capabilities String         @default("[]")
  records      SystemRecord[]
  runs         AutomationRun[]
  shares       ShareLink[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId])
}

/**------------------------------------------------------------------------------
 * Scalar JSON data records (key-value store for system data)
 *-----------------------------------------------------------------------------*/
model SystemRecord {
  id        String   @id @default(cuid())
  systemId  String
  system    AiSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  data      String // JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([systemId])
}

/**------------------------------------------------------------------------------
 * Automation run history
 *-----------------------------------------------------------------------------*/
model AutomationRun {
  id         String   @id @default(cuid())
  systemId   String
  system     AiSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  automation String // the blueprint automation description that was executed
  status     String   @default("RUNNING") // RUNNING | DONE | FAILED
  trigger    String   @default("MANUAL") // MANUAL | SCHEDULE | EVENT
  log        String   @default("[]") // JSON string: [{ t, line, level }]
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([systemId])
}

/**------------------------------------------------------------------------------
 * Durable execution models (Task/Step/Approval/Idempotency/Memory)
 *-----------------------------------------------------------------------------*/

/**------------------------------------------------------------------------------
 * Task model
 *-----------------------------------------------------------------------------*/
model Task {
  id           String    @id @default(cuid())
  tenantId     String
  actorId      String
  workflowType String
  status       String   // queued | running | waiting_for_approval | verifying | succeeded | partially_succeeded | failed | cancelled | expired
  riskClass    String   // LOW | MEDIUM | HIGH | CRITICAL
  input        String // JSON string
  result       String? // JSON string, set only on terminal state
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, id])
  @@index([tenantId, workflowType])
}

/**------------------------------------------------------------------------------
 * Step model
 *-----------------------------------------------------------------------------*/
model Step {
  id          String    @id @default(cuid())
  taskId      String
  sequence    Int
  name        String   // validate_input | policy_check | await_approval | execute_write | verify
  status      String   // pending | running | succeeded | failed | skipped
  attempt     Int      @default(0)
  maxAttempts Int      @default(1)
  output      String?
  errorCode   String?
  errorMessage String?
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([taskId, sequence], unique: true)
  @@index([taskId])
}

/**------------------------------------------------------------------------------
 * TaskEvent model - append-only audit trail
 *-----------------------------------------------------------------------------*/
model TaskEvent {
  id          String    @id @default(cuid())
  taskId      String
  sequence    Int
  type        String   // task_created | step_started | step_succeeded | step_failed | approval_requested | approval_decided | approval_expired | task_status_changed | verification_result
  actorType   String   // system | human | model
  actorId     String?
  payload     String // JSON string (redacted at persistence boundary)
  createdAt   DateTime @default(now())

  @@index([taskId, sequence], unique: true)
  @@index([taskId])
}

/**------------------------------------------------------------------------------
 * ApprovalRequest model
 *-----------------------------------------------------------------------------*/
model ApprovalRequest {
  id          String    @id @default(cuid())
  taskId      String
  stepId      String?
  tenantId    String
  toolName    String
  actionHash  String
  normalizedParams String // JSON string
  policyVersion String
  riskLevel    String
  summary      String
  status      String   // pending | approved | rejected | expired
  requestedAt DateTime
  expiresAt   DateTime
  decidedBy   String?
  decidedAt   DateTime?
  reason      String?

  @@index([tenantId, id], unique: true)
  @@index([taskId])
  @@index([tenantId, toolName, actionHash])
}

/**------------------------------------------------------------------------------
 * IdempotencyRecord model
 *-----------------------------------------------------------------------------*/
model IdempotencyRecord {
  id          String    @id @default(cuid())
  tenantId    String
  toolName    String
  idempotencyKey String
  requestHash String
  status      String   // in_progress | completed | failed
  resultRef   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, toolName, idempotencyKey], unique: true)
  @@index([tenantId])
}

/**------------------------------------------------------------------------------
 * MemoryItem model - tenant-scoped memory
 *-----------------------------------------------------------------------------*/
model MemoryItem {
  id          String    @id @default(cuid())
  tenantId    String
  actorId     String?
  key         String
  value       String // JSON string for complex values
  category    String // preference | confirmed_work_context
  source      String? // model | human | system
  confirmedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, key], unique: true)
  @@index([tenantId])
}
